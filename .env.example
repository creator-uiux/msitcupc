# ITC Maintenance System  --  deployment configuration template.
#
# Copy to `.env`, fill it in on the server and keep it out of the repository
# (`.env` is git-ignored). Every value below is the shape, not a secret.
#
# The server reads the environment, not this file. Export it in whatever way
# the host does it:
#
#   systemd unit   EnvironmentFile=/srv/itc/.env
#   shell          set -a; . /srv/itc/.env; set +a; python server/app.py
#   container      --env-file /srv/itc/.env
#
# Anything left blank keeps the built-in default, and the built-in default is
# the safe one: demo sign-in only on a loopback bind, e-mail off, and the
# Workspace domain limited to upcebu.edu.ph.

# ---------------------------------------------------------------- sign-in
# The Google OAuth 2.0 Web client id of the UP Cebu Workspace. With it the
# login page offers real Google sign-in and `server/oidc.py` verifies the
# id_token itself (RS256 against Google's JWKS, plus issuer, audience, expiry,
# verified e-mail and hosted domain). Without it the demo login is used.
ITC_GOOGLE_CLIENT_ID=
ITC_ALLOWED_DOMAINS=upcebu.edu.ph

# The server-side demo gate: the role shorthand and the seeded demo
# credentials. Unset means on for a loopback bind and off for any
# network-facing bind. Set it to 0 explicitly on a public host; the sign-in
# page keeps listing the four demo accounts, labelled "Demo only", and choosing
# one there only opens a browser-only session over the bundled seed data.
ITC_DEMO_MODE=

# ---------------------------------------------------------------- delivery
# Comma-separated channels. `outbox` is always recorded, even when omitted.
ITC_NOTIFY_CHANNELS=outbox
# ITC_NOTIFY_CHANNELS=outbox,email

ITC_SMTP_HOST=
ITC_SMTP_PORT=587
ITC_SMTP_USER=
ITC_SMTP_PASS=
ITC_SMTP_FROM=it-helpdesk@upcebu.edu.ph
ITC_SMTP_TLS=1

ITC_SMS_WEBHOOK=
ITC_SMS_TOKEN=

# ---------------------------------------------------------------- process
# These are command line flags rather than variables; they are listed here so
# one file describes the whole deployment. See `server/README.md`.
#
#   --host 127.0.0.1 --port 8787   bind address. Keep it on loopback and put a
#                                  TLS-terminating proxy in front; the server
#                                  itself speaks plain HTTP.
#   --db PATH                      the SQLite file. Everything lives in it,
#                                  including the attachment bytes, so this one
#                                  path is the whole backup.
#   --interval 9                   world-clock tick seconds (schedule checks,
#                                  reminders, dependency follow-ups).
#   --no-worker                    only for a read-only or test instance; the
#                                  clock stops moving without a worker.
#   --reset                        re-seeds the demo dataset. Destructive on a
#                                  live database: do not put it in a service
#                                  unit that restarts.
